{
  "name": "howfastami",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A static app for comparing running times with national athletics records.",
  "license": "MIT",
  "scripts": {
    "predev": "npm run data:ensure",
    "dev": "vite",
    "data": "node scripts/build-data.ts",
    "data:ensure": "node scripts/ensure-data.ts",
    "build": "npm run data && npm run build:app",
    "build:app": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run data:ensure && npm run lint && npm run test && npm run build:app && npm run format:check"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.6.1 <13"
  },
  "packageManager": "npm@11.6.1",
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "d3-geo": "^3.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.7",
    "@playwright/test": "^1.62.1",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.2.0",
    "cheerio": "^1.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
